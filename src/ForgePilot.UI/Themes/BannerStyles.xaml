<!--
    Styles for the permission / question / login banners.

    Lives in ForgePilot.UI rather than the VS extension so the Desktop host can
    show the same banners — without them it cannot answer a permission prompt,
    which leaves the CLI blocked. Everything here resolves Fp* brushes, so it
    carries no dependency on the VS shell.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!--
        Composer picker menus (model, effort, session). Applied as an explicit
        style rather than left to the default: an unstyled ContextMenu renders
        as a grey Windows menu with a blue system checkmark, which reads as
        another application intruding on the panel.
    -->
    <Style x:Key="FpMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Accent tick in place of the blue system checkmark. -->
                            <Path x:Name="check"
                                  Grid.Column="0"
                                  Opacity="0"
                                  Stroke="{DynamicResource FpAccent}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 1,5 L 4,8 L 9.5,2"
                                  Width="11" Height="10"
                                  Stretch="None"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              Margin="2,0,14,0"/>

                            <!-- Trailing hint: the keyboard digit, or a word like
                                 "Enable" for a row that is an action rather than
                                 a selection. Dim, so it reads as an affordance
                                 and not as part of the label. -->
                            <TextBlock x:Name="hint"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FpFaint}"
                                       FontSize="12"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpSurfaceSubtle}"/>
                        </Trigger>
                        <!-- Opacity rather than Visibility so the row never
                             reflows as the tick appears. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Opacity" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FpFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FpContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="ItemContainerStyle" Value="{StaticResource FpMenuItemStyle}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <!-- HasDropShadow off: the system shadow is a hard grey rectangle that
             ignores the rounded corner. The DropShadowEffect below follows it. -->
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Outer margin leaves room for the shadow, which would
                         otherwise be clipped by the popup window. -->
                    <Border Margin="8" Padding="0">
                        <Border x:Name="shell"
                                Background="{DynamicResource FpSurface}"
                                BorderBrush="{DynamicResource FpBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270"
                                                  Opacity="0.22" Color="Black" RenderingBias="Quality"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="420">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section caption inside a menu ("Mode"). A TextBlock rather than a
         disabled MenuItem: a disabled item still takes keyboard focus in the
         arrow-key cycle, so the first Down press would land on the caption. -->
    <Style x:Key="FpMenuHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FpFaint}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Margin" Value="12,6,12,4"/>
    </Style>

    <Style x:Key="FpSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,5"/>
        <Setter Property="Background" Value="{DynamicResource FpBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outer card. Matches the composer's radius and border so the banner
         reads as a sibling of the input rather than an alert bolted on top. -->
    <Style x:Key="BannerCardBorderStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource FpSurface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource FpBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Margin"          Value="12,0,12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Primary action (Allow / Sign in / Submit). -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FpAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource FpAccentForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="16,7,16,7"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deny. Outlined in the error colour rather than filled: a filled red
         button next to a filled accent button reads as the louder of the two,
         and declining a tool call is the safe choice, not the alarming one. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FpError}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FpError}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="16,6,16,6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpSurfaceSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neutral tertiary action (Other…). -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FpMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FpBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="16,6,16,6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpSurfaceSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button used to page between questions / go back. -->
    <Style x:Key="ChevronButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FpMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpSurfaceSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BannerInputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource FpBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FpBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FpAccent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FpSelection}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="box"
                                Width="17" Height="17"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource FpBorderStrong}"
                                Background="Transparent"
                                Margin="0,1,9,1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="glyph"
                                       Text="✓"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       LineHeight="12"
                                       LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource FpAccentForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource FpAccent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource FpAccent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource FpAccent}"/>
                            <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="box"
                                Width="17" Height="17"
                                CornerRadius="9"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource FpBorderStrong}"
                                Background="Transparent"
                                Margin="0,1,9,1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border x:Name="dot"
                                    Width="7" Height="7"
                                    CornerRadius="4"
                                    Background="{DynamicResource FpAccentForeground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource FpAccent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource FpAccent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource FpAccent}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
