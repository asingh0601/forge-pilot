<Window x:Class="ForgePilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ForgePilot.UI.Controls;assembly=ForgePilot.UI"
        Title="ForgePilot"
        Height="820" Width="1000"
        MinHeight="420" MinWidth="480"
        Background="{DynamicResource FpBackground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Circular accent send button, the Claude Desktop affordance. It
             disables rather than disappears so the composer doesn't reflow as
             you type the first character. -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource FpAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource FpAccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FpAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FpBorderStrong}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource SendButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header: quiet, single line. The working directory is the only fact
             worth stating, so it carries the emphasis and the title doesn't. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource FpBackground}"
                BorderBrush="{DynamicResource FpBorder}"
                BorderThickness="0,0,0,1"
                Padding="22,13">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✻"
                           FontSize="13"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FpAccent}"/>
                <TextBlock Text="ForgePilot"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FpForeground}"/>
                <TextBlock Text="—"
                           FontSize="13"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FpFaint}"/>
                <TextBlock Text="{Binding WorkingDirectory}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FpMuted}"/>
            </StackPanel>
        </Border>

        <!-- Composer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource FpBackground}"
                Padding="22,10,22,16">
            <StackPanel HorizontalAlignment="Center" MaxWidth="760">

                <!-- Rounded input card. The border carries the visual weight;
                     the textbox inside is chromeless. -->
                <Border CornerRadius="16"
                        Background="{DynamicResource FpSurface}"
                        BorderBrush="{DynamicResource FpBorder}"
                        BorderThickness="1"
                        Padding="6,4,6,6"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBox x:Name="InputTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource FpForeground}"
                                     CaretBrush="{DynamicResource FpAccent}"
                                     SelectionBrush="{DynamicResource FpSelection}"
                                     BorderThickness="0"
                                     Padding="12,9"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="42"
                                     MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="InputTextBox_KeyDown"/>

                            <TextBlock Text="Reply to Claude…"
                                       Margin="14,9,0,0"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       FontSize="14"
                                       Foreground="{DynamicResource FpFaint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,2,2">
                            <Button Style="{StaticResource SendButtonStyle}"
                                    Command="{Binding SendCommand}"
                                    ToolTip="Send (Enter)">
                                <TextBlock Text="↑" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FpAccentForeground}"/>
                            </Button>
                            <Button Style="{StaticResource StopButtonStyle}"
                                    Command="{Binding StopCommand}"
                                    ToolTip="Stop (Esc)">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{DynamicResource FpAccentForeground}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- One status row that swaps content, rather than the old
                     separate "Thinking..." strip that shifted the layout. -->
                <Grid Margin="14,7,14,0">
                    <TextBlock FontSize="11.5"
                               Foreground="{DynamicResource FpFaint}"
                               Text="Enter to send · Shift+Enter for a new line">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActivityGlyph}"
                                   FontSize="11.5"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource FpAccent}"/>
                        <TextBlock Text="{Binding StatusLine}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource FpMuted}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Banner host: permission / question / login prompts. DataTemplates
             arrive when the banner views move into ForgePilot.UI. -->
        <ContentControl DockPanel.Dock="Bottom"
                        x:Name="BannerHost"
                        Content="{Binding ActiveBanner}"
                        Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <controls:ChatWebView x:Name="ChatWebView"/>
    </DockPanel>
</Window>
