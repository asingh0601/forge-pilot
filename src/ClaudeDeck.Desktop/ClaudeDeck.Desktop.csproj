<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeDeck.UI\ClaudeDeck.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Hosting is pinned to [10.0.0] to match the strict pins in ClaudeDeck.UI /
      ClaudeDeck.Services. At 10.0.5 it drags in Microsoft.Extensions.Configuration.Json,
      which demands System.Text.Json >= 10.0.5 and collides head-on with UI's
      strict [10.0.0] pin — NU1107, restore fails outright. Keep this in lockstep
      with the pins in ClaudeDeck.UI.csproj if those ever move.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.0]" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
