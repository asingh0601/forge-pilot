<!--
  The SDK is imported explicitly rather than via Sdk="Microsoft.NET.Sdk" on the
  Project element. That attribute injects Sdk.targets at the very END of the
  file, which would place it AFTER the VSSDK import at the bottom — and the
  VSSDK targets read $(TargetPath) at import time to decide which assembly to
  generate the pkgdef from. Imported too early it sees an empty value and
  GeneratePkgDef fails with VSSDK1032 "No item to process for CreatePkgDef".
  Spelling both imports out lets the VSSDK targets come last, after TargetPath
  exists.
-->
<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>

    <!--
      A plain VSSDK extension: no ExtensionType, and none of the
      .vsextension/extension.json, catalog.json or manifest.json artefacts the
      VisualStudio.Extensibility packaging used to ship. Those were what made
      VS 2026 register the extension as Disabled ("Missing entry in per-user
      enabled extensions cache") so it never appeared under Manage Extensions
      without devenv /setup + /updateconfiguration.

      BUILD WITH MSBUILD FROM A VISUAL STUDIO INSTALL, not `dotnet build`. The
      VSSDK targets ship with the "Visual Studio extension development"
      workload; the import at the bottom of this file is Exists()-guarded, so
      under the .NET SDK the assemblies still compile but no .vsix is produced.
    -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>

    <!-- GenerateTemplatesManifest runs unconditionally and fails with VSSDK1202
         when this is unset. Only relevant to extensions shipping project or
         item templates, which this one does not. -->
    <TemplateOutputDirectory>$(IntermediateOutputPath)Templates\</TemplateOutputDirectory>

    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>

    <!-- Suppress NU1701 warnings -->
    <NoWarn>$(NoWarn);NU1701;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgePilot.UI\ForgePilot.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!-- OleMenuCommandService derives from System.ComponentModel.Design
         .MenuCommandService, which lives in System.Design. Without this the
         AddCommand call fails to bind even though the type resolves. -->
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />

    <!--
      VS-provided BCL shims: compile against these but do NOT ship the
      runtime DLLs. VS bundles its own copies in Common7\IDE\PublicAssemblies
      and PrivateAssemblies; AssemblyResolveBootstrap.cs substitutes them at
      runtime regardless of version drift. See that file for the full
      rationale and the allow-list it probes against.

      Every name that appears in VS's Common7\IDE\PublicAssemblies\ MUST be
      listed here (not just in ForgePilot.Services / ForgePilot.UI) because
      transitive packages from ProjectReferences don't inherit ExcludeAssets
      — they get re-resolved by the consuming project's NuGet graph and
      re-deposited into the host's bin folder. Only an explicit
      PackageReference at the host level overrides that.

      If a transitive graph pulls in a new VS-bundled dep in the future, add
      it here AND add its simple name to AllowList in
      AssemblyResolveBootstrap.cs.
    -->
    <!--
      Strict-pin every version to [10.0.0] — the .NET 10 GA floor. Every
      VS 2026 patch ships an assembly version 10.0.0.x with x >= 0, so
      compiling against the floor guarantees we only ever call APIs that
      exist on every supported VS install. AssemblyResolveBootstrap
      substitutes whatever 10.0.0.x DLL VS actually has on disk at
      runtime, and a 10.0.0 compile is binary-compatible with any later
      patch because the M.E.* API surface is additive across patches.

      The brackets are required to stop NuGet from silently upgrading on
      a restore. See AssemblyResolveBootstrap.cs for the runtime side of
      the contract.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Json" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Encodings.Web" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Threading.Channels" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.IO.Pipelines" Version="[10.0.0]" ExcludeAssets="runtime" />

    <!--
      Not in VS — ship these. Serilog pinned to 4.2.0 because
      Serilog.Extensions.Logging 10.0.0 and Serilog.Sinks.File 7.0.0 were
      both compiled against exactly Serilog 4.2.0.0. Strict strong-name
      binding in .NET Framework rejects any other patch. Same pin used in
      ForgePilot.Services (transitively brought in from there as well).
    -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />

    <!-- Referenced by <License> in the manifest, so it has to be inside the
         package: a referenced-but-absent file fails validation at install. -->
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Command table. VSCTCompile compiles the .vsct into the binary resource
       that [ProvideMenuResource("Menus.ctmenu", 1)] on the package points at;
       ResourceName must match that name exactly. -->
  <ItemGroup>
    <VSCTCompile Include="ForgePilotPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <SubType>Designer</SubType>
    </VSCTCompile>
    <Content Include="Resources\command-icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Extension icon and Marketplace preview. IncludeInVSIX is what actually gets
    them into the package — a plain None item would be referenced by the
    manifest but absent from the .vsix, which fails validation at install time.
    Condition-guarded so the build still succeeds before the logo is generated;
    see assets/make-icons.ps1.
  -->
  <ItemGroup>
    <Content Include="Resources\icon.png" Condition="Exists('$(MSBuildProjectDirectory)\Resources\icon.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\preview.png" Condition="Exists('$(MSBuildProjectDirectory)\Resources\preview.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Import order below is the whole reason this file spells its SDK imports out
    rather than using Sdk="Microsoft.NET.Sdk" on the Project element.

    Sdk.targets must land FIRST so $(TargetPath) and the other common build
    properties exist. The VSSDK targets — which produce the .vsix via
    CreateVsixContainer, VSCTCompile and GeneratePkgDef — read those at import
    time. With the attribute form, Sdk.targets is injected at the very end and
    the VSSDK import sees an empty $(TargetPath), so GeneratePkgDef fails with
    VSSDK1032 "No item to process for CreatePkgDef".

    Microsoft.VSSDK.BuildTools does not import them for us — its targets file
    only sets a few VsSDK* environment variables. A legacy .csproj got the
    import from its ProjectTypeGuids; SDK-style projects have no equivalent.
  -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- Prefer the copy from the VS install (ships with the "Visual Studio
         extension development" workload); fall back to the NuGet package's own
         copy so a machine without the workload can still try. -->
    <VsSDKTargetsPath Condition="'$(VsSDKTargetsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\VSSDK\Microsoft.VsSDK.targets')">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\VSSDK\Microsoft.VsSDK.targets</VsSDKTargetsPath>
    <VsSDKTargetsPath Condition="'$(VsSDKTargetsPath)' == '' AND Exists('$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2120\tools\VSSDK\Microsoft.VsSDK.targets')">$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2120\tools\VSSDK\Microsoft.VsSDK.targets</VsSDKTargetsPath>
  </PropertyGroup>

  <Import Project="$(VsSDKTargetsPath)" Condition="'$(VsSDKTargetsPath)' != ''" />

  <!--
    CreatePkgDef reflects over the built assembly to find its registration
    attributes, so every assembly it references must be resolvable. Ours are
    not: the VS-provided assemblies are deliberately ExcludeAssets="runtime"
    (see the note above and AssemblyResolveBootstrap.cs) so they never land in
    the output folder, and CreatePkgDef then fails with FileNotFoundException on
    Microsoft.VisualStudio.Shell.Framework.

    Pointing it at the VS install's own assembly folders resolves them without
    shipping anything extra — GeneratePkgDef appends to this item rather than
    replacing it, so seeding it here is enough.
  -->
  <PropertyGroup>
    <VsIdeDir Condition="'$(VsIdeDir)' == ''">$(MSBuildExtensionsPath32)\..\Common7\IDE\</VsIdeDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(VsIdeDir)PublicAssemblies')">
    <CreatePkgDefReferencedAssemblies Include="$(VsIdeDir)PublicAssemblies\*.dll" />
    <CreatePkgDefReferencedAssemblies Include="$(VsIdeDir)PrivateAssemblies\*.dll" Condition="Exists('$(VsIdeDir)PrivateAssemblies')" />
  </ItemGroup>

</Project>
