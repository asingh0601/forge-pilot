<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>

    <!--
      PACKAGING — read before changing.

      The VisualStudio.Extensibility packaging below is what produces the .vsix.
      It is also what stamps ExtensionType="VSSDK+VisualStudio.Extensibility"
      and ships .vsextension/extension.json, catalog.json and manifest.json —
      the remaining suspects for VS 2026 registering the extension as Disabled
      ("Missing entry in per-user enabled extensions cache"), so it does not
      appear under Manage Extensions until devenv /setup +
      /updateconfiguration rebuild the caches. It installs and runs regardless.

      MIGRATION TO A PLAIN VSSDK PACKAGE — attempted, not finished.

      With the "Visual Studio extension development" workload installed, the
      VSSDK targets are available at
        $(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\VSSDK\Microsoft.VsSDK.targets
      but they are NOT imported automatically: Microsoft.VSSDK.BuildTools' own
      targets file merely sets a few VsSDK* environment variables, and the
      import that a legacy .csproj got from its ProjectTypeGuids has no
      equivalent in an SDK-style project. Adding the import explicitly does make
      CreateVsixContainer resolve, and then:

        - GenerateTemplatesManifest fails with VSSDK1202 unless
          $(TemplateOutputDirectory) is set (harmless: no templates ship here);
        - CreateVsixContainer then fails with VSSDK1025, missing the pkgdef;
        - forcing GeneratePkgDef fails with VSSDK1032, "No item to process",
          because the SDK-style build never populates the item that target
          expects.

      Each step is a separate SDK-style/VSSDK integration gap. Finishing it most
      likely means converting this to a legacy-format VSIX project rather than
      patching targets one by one. The menu command already exists as a classic
      .vsct (ForgePilotPackage.vsct + a commented OleMenuCommand path), so no
      code depends on the Extensibility model — only the packaging does.
    -->
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>

    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>

    <!-- Suppress NU1701 warnings -->
    <NoWarn>$(NoWarn);NU1701;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgePilot.UI\ForgePilot.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!-- OleMenuCommandService derives from System.ComponentModel.Design
         .MenuCommandService, which lives in System.Design. Without this the
         AddCommand call fails to bind even though the type resolves. -->
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaging only — see the note above. The project contributes no
         [VisualStudioContribution] commands; ForgePilotExtension is a stub the
         Extensibility build requires (VSEXT0004). -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />

    <!--
      VS-provided BCL shims: compile against these but do NOT ship the
      runtime DLLs. VS bundles its own copies in Common7\IDE\PublicAssemblies
      and PrivateAssemblies; AssemblyResolveBootstrap.cs substitutes them at
      runtime regardless of version drift. See that file for the full
      rationale and the allow-list it probes against.

      Every name that appears in VS's Common7\IDE\PublicAssemblies\ MUST be
      listed here (not just in ForgePilot.Services / ForgePilot.UI) because
      transitive packages from ProjectReferences don't inherit ExcludeAssets
      — they get re-resolved by the consuming project's NuGet graph and
      re-deposited into the host's bin folder. Only an explicit
      PackageReference at the host level overrides that.

      If a transitive graph pulls in a new VS-bundled dep in the future, add
      it here AND add its simple name to AllowList in
      AssemblyResolveBootstrap.cs.
    -->
    <!--
      Strict-pin every version to [10.0.0] — the .NET 10 GA floor. Every
      VS 2026 patch ships an assembly version 10.0.0.x with x >= 0, so
      compiling against the floor guarantees we only ever call APIs that
      exist on every supported VS install. AssemblyResolveBootstrap
      substitutes whatever 10.0.0.x DLL VS actually has on disk at
      runtime, and a 10.0.0 compile is binary-compatible with any later
      patch because the M.E.* API surface is additive across patches.

      The brackets are required to stop NuGet from silently upgrading on
      a restore. See AssemblyResolveBootstrap.cs for the runtime side of
      the contract.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Json" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Encodings.Web" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Threading.Channels" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="[10.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="System.IO.Pipelines" Version="[10.0.0]" ExcludeAssets="runtime" />

    <!--
      Not in VS — ship these. Serilog pinned to 4.2.0 because
      Serilog.Extensions.Logging 10.0.0 and Serilog.Sinks.File 7.0.0 were
      both compiled against exactly Serilog 4.2.0.0. Strict strong-name
      binding in .NET Framework rejects any other patch. Same pin used in
      ForgePilot.Services (transitively brought in from there as well).
    -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />

    <!-- Referenced by <License> in the manifest, so it has to be inside the
         package: a referenced-but-absent file fails validation at install. -->
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ForgePilotPackage.vsct is checked in but NOT compiled: VSCTCompile needs
       Microsoft.VSSDK.BuildTools' targets, which do not run without the VS
       extension development workload. Listing it here would emit no menu
       resource and silently remove the View > Other Windows entry. It is kept
       ready for the switch described in the packaging note above. -->
  <ItemGroup>
    <None Include="ForgePilotPackage.vsct" />
    <Content Include="Resources\command-icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Extension icon and Marketplace preview. IncludeInVSIX is what actually gets
    them into the package — a plain None item would be referenced by the
    manifest but absent from the .vsix, which fails validation at install time.
    Condition-guarded so the build still succeeds before the logo is generated;
    see assets/make-icons.ps1.
  -->
  <ItemGroup>
    <Content Include="Resources\icon.png" Condition="Exists('$(MSBuildProjectDirectory)\Resources\icon.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\preview.png" Condition="Exists('$(MSBuildProjectDirectory)\Resources\preview.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
