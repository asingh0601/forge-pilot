<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="ForgePilot.VSExtension.8f4b1c27-6d3a-4e59-9a10-b7c2e5d84f13"
              Version="1.0.1"
              Language="en-US"
              Publisher="Abhishek Singh" />
    <DisplayName>Forge Pilot</DisplayName>
    <Description xml:space="preserve">Chat with Claude inside Visual Studio to explore, understand and modify your codebase. Forge Pilot drives the Claude Code CLI from a docked tool window styled after the Claude Code UI: collapsible tool runs, inline diffs, todo lists, permission prompts, and a composer with model, thinking-effort and plan/act controls. Requires Node.js, the Claude Code CLI, and a Claude Pro or Max subscription. Fork of VsAgentic by Adolfo Marinucci, MIT licensed.</Description>

    <!--
      Everything below feeds the Extension Manager's details pane. Element order
      is fixed by the v2 schema — Identity, DisplayName, Description, MoreInfo,
      License, GettingStartedGuide, ReleaseNotes, Icon, PreviewImage, Tags — and
      the package fails schema validation at build if they are reordered.

      License is a path into the VSIX, so LICENSE must also be packaged as
      Content with IncludeInVSIX; a referenced-but-absent file fails validation
      at install time rather than at build.
    -->
    <MoreInfo>https://github.com/asingh0601/forge-pilot</MoreInfo>
    <License>LICENSE.txt</License>
    <GettingStartedGuide>https://github.com/asingh0601/forge-pilot#readme</GettingStartedGuide>
    <ReleaseNotes>https://github.com/asingh0601/forge-pilot/releases</ReleaseNotes>

    <!-- Generated from assets/logo.png by assets/make-icons.ps1.
         VS expects Icon at 90x90 and PreviewImage at 200x200. -->
    <Icon>Resources\icon.png</Icon>
    <PreviewImage>Resources\preview.png</PreviewImage>
    <Tags>ai, claude, claude code, agentic, coding assistant, chat, copilot alternative</Tags>
  </Metadata>
  <!-- Installation block kept identical to upstream VsAgentic, including the
       open-ended version range. Bounding it to [17.0,19.0) was tried and made
       no difference to whether the extension lists or its menu appears. -->
  <Installation ExtensionType="VSSDK+VisualStudio.Extensibility">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[17.0,20.0)"
                  DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="ForgePilot.VSExtension" Path="|ForgePilot.VSExtension;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="ForgePilot.VSExtension" Path="|ForgePilot.VSExtension|" />

    <!-- Marketplace listing body. Only read when the package is published; it
         is inert for a local install, but shipping it in the VSIX keeps the
         listing and the build from drifting apart. -->
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" />
  </Assets>
</PackageManifest>
