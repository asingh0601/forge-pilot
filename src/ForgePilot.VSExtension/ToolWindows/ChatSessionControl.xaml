<UserControl x:Class="ForgePilot.VSExtension.ToolWindows.ChatSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:controls="clr-namespace:ForgePilot.UI.Controls;assembly=ForgePilot.UI"
             xmlns:bvm="clr-namespace:ForgePilot.UI.ViewModels.Banners;assembly=ForgePilot.UI"
             xmlns:bv="clr-namespace:ForgePilot.UI.Controls.Banners;assembly=ForgePilot.UI" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Brings in FpContextMenuStyle / FpMenuItemStyle for the
                     composer pickers, alongside the banner styles. -->
                <ResourceDictionary Source="/ForgePilot.UI;component/Themes/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Banner DataTemplates: ContentControl below picks the right view by VM type. -->
        <DataTemplate DataType="{x:Type bvm:PermissionBannerViewModel}">
            <bv:PermissionBannerControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type bvm:LoginBannerViewModel}">
            <bv:LoginBannerControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type bvm:QuestionCardViewModel}">
            <bv:QuestionCardControl/>
        </DataTemplate>

        <!-- Borderless icon button used inside the input status bar -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource FpSurfaceSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource FpSelection}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular accent send button. Disables rather than disappearing, so
             the composer doesn't reflow when the first character is typed. -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource FpAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FpAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FpBorderStrong}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource SendButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Composer footer chip: model / effort. Carries a faint outline so it
             reads as something you can press — plain text at this size looked
             like a label. A caret marks it as opening a menu. -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource FpMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource FpBorder}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,4"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="caret"
                                      Margin="6,1,0,0"
                                      Stroke="{DynamicResource FpFaint}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 0,0 L 3.5,3.5 L 7,0"
                                      Width="7" Height="4"
                                      Stretch="None"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpSurfaceSubtle}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FpBorderStrong}"/>
                                <Setter TargetName="caret" Property="Stroke" Value="{DynamicResource FpMuted}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plan / Act is a toggle, not a menu, so it gets no caret and instead
             switches between a filled accent pill (Plan: nothing will be
             changed) and a plain outline (Act). A dot carries the state at a
             glance, since the two words are similar in length and colour alone
             is not a reliable signal. -->
        <Style x:Key="ModeChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FpMuted}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource FpBorder}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,4"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot"
                                         Width="6" Height="6"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource FpFaint}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FpBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FpForeground}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlanMode}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource FpAccentSubtle}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FpAccent}"/>
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource FpAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FpAccent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem template used in the @-mention popup -->
        <Style x:Key="MentionItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource FpSurfaceSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource FpAccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="RootPanel"
               Background="{DynamicResource FpBackground}"
               TextOptions.TextFormattingMode="Ideal">

        <!-- Header: session picker + new session. Replaces the separate session
             list tool window as the primary way to move between sessions. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource FpBackground}"
                BorderBrush="{DynamicResource FpBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SessionMenuButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IconButtonStyle}"
                        Click="SessionMenuButton_Click"
                        ToolTip="Switch session">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✻"
                                   FontSize="12"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FpAccent}"/>
                        <TextBlock x:Name="SessionNameText"
                                   Text="Forge Pilot"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FpForeground}"/>
                        <TextBlock Text="⌄"
                                   FontSize="12"
                                   Margin="7,-3,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FpMuted}"/>
                    </StackPanel>
                </Button>

                <!-- Commands and skills are reached by typing "/" in the
                     composer, so a header button for them was a second door to
                     the same room. -->
                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="NewSessionButton_Click"
                        ToolTip="New session">
                    <TextBlock Text="+"
                               FontSize="17"
                               Margin="0,-3,0,0"
                               Foreground="{DynamicResource FpMuted}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Input Area -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource FpBackground}"
                Padding="12,2,12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- resize grip -->
                    <RowDefinition Height="Auto"/>  <!-- composer card -->
                    <RowDefinition Height="Auto"/>  <!-- status line -->
                </Grid.RowDefinitions>

                <!-- Resize grip: thin transparent strip the user can drag up/down -->
                <Border x:Name="ResizeGrip"
                        Grid.Row="0"
                        Height="6"
                        Background="Transparent"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        ToolTip="Drag to resize input"/>

                <!-- Rounded input container holding the textbox + status bar -->
                <Border Grid.Row="1"
                        CornerRadius="14"
                        Background="{DynamicResource FpSurface}"
                        BorderBrush="{DynamicResource FpBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Text input + placeholder overlay -->
                        <Grid Grid.Row="0">
                            <TextBox x:Name="InputTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource FpForeground}"
                                     CaretBrush="{DynamicResource FpAccent}"
                                     SelectionBrush="{DynamicResource FpSelection}"
                                     BorderThickness="0"
                                     Padding="13,10"
                                     FontSize="14.5"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="42"
                                     MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="InputTextBox_KeyDown"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                     TextChanged="InputTextBox_TextChanged"
                                     SelectionChanged="InputTextBox_SelectionChanged"
                                     LostKeyboardFocus="InputTextBox_LostKeyboardFocus"/>

                            <!-- @-mention popup: anchored above the input box, holds a filtered file/folder list -->
                            <Popup x:Name="MentionPopup"
                                   PlacementTarget="{Binding ElementName=InputTextBox}"
                                   Placement="Top"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource FpSurface}"
                                        BorderBrush="{DynamicResource FpBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="260"
                                        MaxWidth="520"
                                        SnapsToDevicePixels="True">
                                    <ListBox x:Name="MentionList"
                                             MaxHeight="220"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             ItemContainerStyle="{StaticResource MentionItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonDown="MentionList_PreviewMouseLeftButtonDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <imaging:CrispImage Grid.Column="0"
                                                                        Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0"
                                                                        Moniker="{Binding Moniker}"/>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelativePath}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource FpForeground}"/>
                                                        <!-- Command descriptions; empty for file mentions,
                                                             where the path is the whole story. -->
                                                        <TextBlock Text="{Binding Description}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                                                   Margin="8,0,0,0"
                                                                   MaxWidth="320"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource FpFaint}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <TextBlock Text="Reply to Claude…"
                                       Margin="14,9,0,0"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       FontSize="14"
                                       Foreground="{DynamicResource FpFaint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Action row. No separator line: the rounded card is
                             one surface, the way the desktop app composer reads. -->
                        <Grid Grid.Row="1" Margin="6,0,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- @ + mode -->
                                <ColumnDefinition Width="*"/>     <!-- status -->
                                <ColumnDefinition Width="Auto"/>  <!-- model + effort -->
                                <ColumnDefinition Width="Auto"/>  <!-- send / stop -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                <Button x:Name="ModelChip"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Click="ModelChip_Click"
                                        Content="{Binding ModelLabel}"
                                        ToolTip="Model for this session"/>
                                <Button x:Name="EffortChip"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Click="EffortChip_Click"
                                        Content="{Binding EffortLabel}"
                                        ToolTip="Extended thinking budget"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- @-mention attach button: opens the file/folder picker popup -->
                                <Button x:Name="AtMentionButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="AtMentionButton_Click"
                                        ToolTip="Insert file or folder reference (@)">
                                    <TextBlock Text="@"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FpMuted}"/>
                                </Button>

                                <Button x:Name="ModeChip"
                                        Style="{StaticResource ModeChipStyle}"
                                        Click="ModeChip_Click"
                                        Content="{Binding ModeLabel}"
                                        ToolTip="Permission mode — how much Claude may do without asking"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       x:Name="StatusInfoText"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource FpFaint}"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Send / Stop: circular accent button, Claude Desktop style -->
                            <Grid Grid.Column="3">
                                <Button Style="{StaticResource SendButtonStyle}"
                                        Command="{Binding SendCommand}"
                                        ToolTip="Send (Enter)">
                                    <!-- Drawn rather than typed: the ↑ glyph renders thin and
                                         differs per installed font. A Path gives a consistent
                                         weight and stays crisp at any DPI. -->
                                    <Path Stroke="{DynamicResource FpAccentForeground}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 7,11.5 L 7,2.5 M 2.5,7 L 7,2.5 L 11.5,7"
                                          Width="14" Height="14"
                                          Stretch="None"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource StopButtonStyle}"
                                        Command="{Binding StopCommand}"
                                        ToolTip="Stop processing (Esc)">
                                    <Border Width="9" Height="9" CornerRadius="2"
                                            Background="{DynamicResource FpAccentForeground}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- One status row that swaps content, replacing the old
                     separate "Thinking..." strip that shifted the layout. -->
                <Grid Grid.Row="2" Margin="14,6,14,0">
                    <!-- Two rows. The hint and the working line swap inside row 0
                         (they are mutually exclusive on IsBusy), while usage gets
                         a row of its own — it is visible in both states, so
                         sharing a cell drew it on top of the hint. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="11.5"
                               Foreground="{DynamicResource FpFaint}"
                               Text="Enter to send · Shift+Enter for a new line · @ for files">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActivityGlyph}"
                                   FontSize="11.5"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource FpAccent}"/>
                        <TextBlock Text="{Binding StatusLine}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource FpMuted}"/>
                    </StackPanel>

                    <!-- Not tied to IsBusy: the total is worth reading after a
                         turn ends, which is exactly when the working line
                         disappears. -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding UsageLine}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource FpFaint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsageLine}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Banner host: permission / question / login banner. The DataTemplates
             above pick the matching UserControl by VM type. The host collapses
             when ActiveBanner is null so it consumes no space when idle. -->
        <ContentControl DockPanel.Dock="Bottom"
                        x:Name="BannerHost"
                        Content="{Binding ActiveBanner}"
                        Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Chat Messages Area - single WebView -->
        <controls:ChatWebView x:Name="ChatWebView" />
    </DockPanel>
</UserControl>
